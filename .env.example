# Скопіюйте у .env і експортуйте змінні (або задайте у systemd/Docker). Реальні значення не комітьте.
PORT=3000
NODE_ENV=production
# Публічна адреса сайту (для canonical, sitemap, Open Graph)
PUBLIC_URL=https://example.com
# Каталог з базою та завантаженнями (змонтуйте на постійний диск)
DATA_DIR=./data
# 1, якщо сайт стоїть за reverse proxy (nginx) і передає X-Forwarded-For
TRUST_PROXY=0
